# Google Apps Script web app URL (deploy → Web app → Anyone → /exec URL)
VITE_CONTACT_FORM_URL=

# reCAPTCHA v3 site key (public; secret stays in Apps Script Script Properties)
VITE_RECAPTCHA_SITE_KEY=

# Base URL for images/videos served from the DigitalOcean Spaces CDN (no trailing slash, required)
VITE_CDN_BASE=

# Public site origin for canonical and og:url (no trailing slash; defaults to https://populardigital.ai)
VITE_SITE_URL=
